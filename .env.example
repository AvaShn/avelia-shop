# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL
# Runtime on Vercel: Supavisor transaction pooler (usually port 6543)
DATABASE_URL=
# Prisma migrations/seed: direct or Supavisor session connection (usually port 5432)
DIRECT_URL=

# Telegram payment
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_ID=
TELEGRAM_WEBHOOK_SECRET=
PAYMENT_SESSION_SECRET=
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
# Inventory remains reserved while a manual payment is pending (default: 24 hours)
ORDER_RESERVATION_MINUTES=1440
# Protects the scheduled endpoint that releases expired reservations
INVENTORY_CRON_SECRET=

# Private receipt storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECEIPTS_BUCKET=payment-receipts

# Admin authentication
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Email confirmation
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
