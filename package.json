{
  "name": "avelia-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:telegram": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-with-system-proxy.ps1 tsx scripts/telegram/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma": "prisma",
    "studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:verify": "tsx prisma/verify.ts",
    "account:verify": "tsx scripts/verify-account-flow.ts",
    "admin:hash-password": "tsx scripts/hash-admin-password.ts",
    "telegram:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-with-system-proxy.ps1 tsx scripts/telegram/check.ts",
    "telegram:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-with-system-proxy.ps1 tsx scripts/telegram/configure.ts",
    "telegram:poll": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-with-system-proxy.ps1 tsx scripts/telegram/poll.ts",
    "telegram:webhook:set": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-with-system-proxy.ps1 tsx scripts/telegram/webhook.ts set",
    "telegram:webhook:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-with-system-proxy.ps1 tsx scripts/telegram/webhook.ts status",
    "telegram:webhook:delete": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-with-system-proxy.ps1 tsx scripts/telegram/webhook.ts delete",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@persian-tools/persian-tools": "^4.0.4",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.46.0",
    "next": "15.5.25",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
