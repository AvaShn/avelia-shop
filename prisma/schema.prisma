generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING_PAYMENT
  WAITING_REVIEW
  PAID
  REJECTED
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id                 String        @id @default(cuid())
  name               String
  phoneNormalized    String        @unique
  email              String?       @unique
  passwordHash       String?
  telegramId         String?       @unique
  defaultCity        String?
  defaultAddressLine String?
  defaultPostalCode  String?
  defaultPlaque      String?
  defaultUnit        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  orders             Order[]
  sessions           UserSession[]
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  image     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                 String      @id @default(dbgenerated("gen_random_uuid()::text"))
  name               String
  slug               String      @unique
  shortDescription   String
  description        String
  brand              String
  priceRial          BigInt
  compareAtPriceRial BigInt?
  images             String[]
  keyFeatures        String[]
  usage              String
  stock              Int
  isOriginal         Boolean     @default(true)
  isFeatured         Boolean     @default(false)
  isPublished        Boolean     @default(true)
  sortOrder          Int         @default(0)
  categoryId         String
  category           Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems         OrderItem[]
  cartItems          CartItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt

  @@index([categoryId])
  @@index([categoryId, isPublished])
  @@index([isFeatured, sortOrder])
  @@index([isPublished, sortOrder])
  @@index([sortOrder])
}

model Cart {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  expiresAt    DateTime
  checkedOutAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]
  order        Order?

  @@index([expiresAt])
  @@index([checkedOutAt, updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id                            String      @id @default(cuid())
  publicToken                   String      @unique
  checkoutIdempotencyKeyHash    String      @unique
  userId                        String
  user                          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartId                        String?     @unique
  cart                          Cart?       @relation(fields: [cartId], references: [id], onDelete: SetNull)
  totalPriceRial                BigInt
  recipientName                 String
  recipientPhoneNormalized      String
  recipientEmail                String
  shippingCity                  String
  shippingAddressLine           String
  shippingPostalCode            String
  shippingPlaque                String
  shippingUnit                  String?
  status                        OrderStatus @default(PENDING_PAYMENT)
  inventoryReservationExpiresAt DateTime
  inventoryCommittedAt          DateTime?
  inventoryReleasedAt           DateTime?
  rejectionReason               String?
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime    @updatedAt
  items                         OrderItem[]
  payment                       Payment?

  @@index([userId])
  @@index([status, createdAt])
  @@index([inventoryReservationExpiresAt, inventoryReleasedAt])
  @@index([createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int
  unitPriceRial BigInt
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([orderId, createdAt])
  @@index([productId])
}

model Payment {
  id                      String        @id @default(cuid())
  orderId                 String        @unique
  order                   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentSessionTokenHash String        @unique
  sessionExpiresAt        DateTime
  receiptObjectKey        String?
  telegramFileId          String?
  providerUpdateId        String?       @unique
  status                  PaymentStatus @default(PENDING)
  reviewedAt              DateTime?
  reviewedBy              String?
  reviewNote              String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([sessionExpiresAt])
  @@index([reviewedAt])
}

model ApiRateLimit {
  scope       String
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([scope, keyHash, windowStart])
  @@index([expiresAt])
}
