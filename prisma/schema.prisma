generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING_PAYMENT
  RECEIPT_SUBMITTED
  PAID
  REJECTED
  CANCELED
}

enum PaymentStatus {
  WAITING_RECEIPT
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique
  email      String?  @unique
  telegramId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  image     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                 String      @id @default(cuid())
  name               String
  slug               String      @unique
  shortDescription   String
  description        String
  brand              String
  priceRial          BigInt
  compareAtPriceRial BigInt?
  images             Json
  keyFeatures        String[]
  usage              String
  stock              Int
  isOriginal         Boolean     @default(true)
  isFeatured         Boolean     @default(false)
  sortOrder          Int         @default(0)
  categoryId         String
  category           Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems         OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([categoryId])
  @@index([isFeatured, sortOrder])
  @@index([sortOrder])
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  totalPrice BigInt
  status     OrderStatus @default(PENDING_PAYMENT)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]
  payment    Payment?

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  price     BigInt

  @@unique([orderId, productId])
  @@index([productId])
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String        @unique
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receiptImage String?
  status       PaymentStatus @default(WAITING_RECEIPT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}
